<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flow Analysis - <%= project.name %> | Ticketsystem</title>
    <link rel="stylesheet" href="/style.css?v=2">
    <link rel="stylesheet" href="/bpmn-js/assets/diagram-js.css">
    <link rel="stylesheet" href="/bpmn-js/assets/bpmn-js.css">
    <link rel="stylesheet" href="/bpmn-js/assets/bpmn-font/css/bpmn.css">
    <style>
        .bpmn-program-badge {
            display: inline-block;
            max-width: 150px;
            padding: 1px 6px;
            border-radius: 9999px;
            font-size: 10px;
            line-height: 1.4;
            color: #1f2937;
            border: 1px solid rgba(0, 0, 0, 0.15);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
        }
        .bpmn-legend-item {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 11px;
            color: #374151;
        }
        .bpmn-legend-swatch {
            display: inline-block;
            width: 12px;
            height: 12px;
            border-radius: 3px;
            border: 1px solid rgba(0, 0, 0, 0.2);
        }
        .a4-page {
            position: relative;
            height: min(78vh, 1123px);
            aspect-ratio: 210 / 297;
            margin: 0 auto;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
        }
        .a4-page--landscape {
            height: min(70vh, 793px);
            aspect-ratio: 297 / 210;
        }
        .bpmn-canvas {
            position: absolute;
            inset: 0;
        }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <div class="flex-shrink-0 flex items-center gap-2">
                        <div class="w-8 h-8 bg-primary-600 rounded-lg flex items-center justify-center">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
                            </svg>
                        </div>
                        <a href="/" class="text-xl font-bold text-gray-900 hover:text-primary-600">Ticketsystem</a>
                    </div>
                    <div class="hidden md:ml-8 md:flex md:space-x-1">
                        <a href="/" class="nav-link">Dashboard</a>
                        <a href="/features" class="nav-link">Features</a>
                        <a href="/ticket/new" class="nav-link">Neues Ticket</a>
                        <a href="/projects" class="nav-link active">Projekte</a>
                        <% if (role === 'admin' || role === 'root') { %>
                        <a href="/stats" class="nav-link">Statistiken</a>
                        <a href="/admin/systems" class="nav-link">Systeme</a>
                        <a href="/admin/staff" class="nav-link">Mitarbeiter</a>
                        <% if (role === 'root') { %><a href="/admin/users" class="nav-link">Benutzer</a><% } %>
                        <% } %>
                    </div>
                </div>
                <div class="flex items-center gap-2 sm:gap-4">
                    <span class="hidden sm:inline text-sm text-gray-600"><%= user %> <span class="badge bg-gray-100 text-gray-700"><%= role %></span></span>
                    <a href="/account" class="hidden sm:inline-flex btn-secondary text-sm">Account</a>
                    <a href="/logout" class="hidden sm:inline-flex btn-secondary text-sm">Abmelden</a>
                    <button type="button" id="mobileNavToggle" class="md:hidden btn-secondary text-sm px-3 py-2" aria-label="Menü öffnen" aria-controls="mobileNav" aria-expanded="false">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
        <%- include('partials/mobile-nav') %>
    </nav>

    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <nav class="flex items-center gap-2 text-sm mb-4">
            <a href="/projects" class="text-gray-500 hover:text-gray-700">Projekte</a>
            <span class="text-gray-400">/</span>
            <a href="/project/<%= project.id %>" class="text-gray-500 hover:text-gray-700"><%= project.name %></a>
            <span class="text-gray-400">/</span>
            <span class="text-gray-900 font-medium">Flow Analysis</span>
        </nav>

        <div class="mb-6">
            <h1 class="text-2xl font-bold text-gray-900">Flow Analysis</h1>
            <p class="text-sm text-gray-500 mt-1">
                <%= project.name %><% if (project.system_name) { %> · <%= project.system_name %><% } %><% if (project.department_name) { %> · <%= project.hospital_name ? project.hospital_name + ' · ' : '' %><%= project.department_name %><% } %>
            </p>
            <p class="text-sm text-gray-600 mt-2">
                Bestehende Workflows erfassen, Probleme sammeln und daraus den Zielzustand ableiten.
            </p>
        </div>

        <%- include('partials/project-nav', { active: 'flow' }) %>

        <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
            <div>
                <h2 class="text-lg font-semibold text-gray-900">Workflows</h2>
                <p class="mt-1 text-sm text-gray-600">
                    Je Workflow stehen Beschreibung, Probleme, Adoptionsrisiken, Dokumente,
                    Input-Visualisierung und Output zusammen in einer einklappbaren Karte.
                </p>
            </div>
            <% if (canManage) { %>
            <button type="button" class="btn-primary text-sm whitespace-nowrap" onclick="openNewWorkflow()">+ Neuer Workflow</button>
            <% } %>
        </div>

        <% if (workflowGroups.length === 0 && !unassigned.hasData) { %>
        <div class="card border-2 border-dashed border-gray-200 bg-white/60">
            <div class="card-body text-sm text-gray-600">
                <p>Noch kein Workflow erfasst.</p>
                <p class="mt-2 text-gray-500">Lege einen an, z. B. „Entlassungsbrief“ oder „Wochenplan erstellen“.</p>
                <% if (canManage) { %>
                <button type="button" class="btn-primary mt-3 text-sm" onclick="openNewWorkflow()">Ersten Workflow anlegen</button>
                <% } %>
            </div>
        </div>
        <% } %>

        <% workflowGroups.forEach(group => { %>
        <%- include('partials/flow-workflow-card', { group, canManage, aiStaff, hasWorkflows }) %>
        <% }); %>

        <% if (unassigned.hasData) { %>
        <%- include('partials/flow-workflow-card', { group: unassigned, canManage, aiStaff, hasWorkflows }) %>
        <% } %>
    </main>

    <% if (canManage) { %>
    <div id="entryModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
        <div class="w-full max-w-2xl rounded-lg bg-white shadow-xl">
            <div class="flex items-center justify-between gap-3 border-b border-gray-200 px-4 py-3">
                <h3 id="entryModalTitle" class="text-base font-semibold text-gray-900">Eintrag bearbeiten</h3>
                <button type="button" class="text-gray-400 hover:text-gray-600" onclick="closeEntry()" aria-label="Schliessen">&times;</button>
            </div>
            <form id="entryForm" class="space-y-3 px-4 py-4">
                <input type="hidden" name="kind" value="">
                <input type="hidden" name="id" value="">
                <div id="entryNameRow" class="hidden">
                    <label for="entryName" class="mb-1 block text-sm font-medium text-gray-700">Name</label>
                    <input type="text" id="entryName" name="name" class="form-input"
                           placeholder="z. B. Workflow Entlassungsbrief">
                    <p class="mt-1 text-xs text-gray-500">Kurzer Titel, unter dem der Workflow in der Liste erscheint.</p>
                </div>
                <div id="entryWorkflowRow" class="hidden">
                    <label for="entryWorkflow" class="mb-1 block text-sm font-medium text-gray-700">Workflow</label>
                    <select id="entryWorkflow" name="workflow_id" class="form-select">
                        <option value="">Ohne Workflow</option>
                        <% workflows.forEach(workflow => { %>
                        <option value="<%= workflow.id %>"><%= workflow.name || workflow.text %></option>
                        <% }); %>
                    </select>
                    <p class="mt-1 text-xs text-gray-500">Ordnet den Eintrag einer Workflow-Karte zu.</p>
                </div>
                <div>
                    <label id="entryTextLabel" class="mb-1 block text-sm font-medium text-gray-700">Text</label>
                    <textarea name="text" rows="8" required class="form-input"></textarea>
                </div>
                <div id="entryDescriptionRow">
                    <label class="mb-1 block text-sm font-medium text-gray-700">Beschreibung</label>
                    <textarea name="description" rows="4" class="form-input" placeholder="Zusaetzliche Details, optional"></textarea>
                </div>
                <p id="entryOrigin" class="text-xs text-gray-500"></p>
                <div class="flex items-center gap-3 border-t border-gray-100 pt-3">
                    <button type="submit" id="entrySaveButton" class="btn-primary text-sm">Speichern</button>
                    <button type="button" class="btn-secondary text-sm" onclick="closeEntry()">Abbrechen</button>
                </div>
            </form>
        </div>
    </div>
    <% } %>

    <% if (bpmnDiagrams.length > 0) { %>
    <script src="/bpmn-js/bpmn-modeler.production.min.js"></script>
    <% } %>
    <script>
        const CSRF_TOKEN = '<%= csrfToken %>';
        const PROJECT_ID = <%= project.id %>;

        const ENTRY_ENDPOINTS = {
            workflows: 'workflows',
            problems: 'problems',
            adoptionRisks: 'adoption-risks'
        };
        const ENTRY_TEXT_FIELDS = {
            workflows: 'description',
            problems: 'title',
            adoptionRisks: 'title'
        };
        const ENTRY_LABELS = {
            workflows: 'Beschreibung',
            problems: 'Titel',
            adoptionRisks: 'Titel'
        };

        function groupRoot(key) {
            return document.querySelector('[data-flow-group="' + key + '"]');
        }

        function workflowIdOf(key) {
            const root = groupRoot(key);
            const value = root ? root.dataset.workflowId : '';
            return value ? Number(value) : null;
        }

        // --- Eintraege anlegen und entfernen ---

        async function addEntry(event, kind) {
            event.preventDefault();
            const form = event.target;
            const value = (form.elements.value.value || '').trim();
            if (!value) { form.elements.value.focus(); return; }

            const payload = {};
            payload[ENTRY_TEXT_FIELDS[kind]] = value;
            const workflowField = form.elements.workflow_id;
            if (workflowField && workflowField.value) {
                payload.workflow_id = Number(workflowField.value);
            }

            const resp = await fetch('/api/projects/' + PROJECT_ID + '/' + ENTRY_ENDPOINTS[kind], {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
                body: JSON.stringify(payload)
            });
            if (resp.ok) { location.reload(); return; }
            const err = await resp.json().catch(() => ({}));
            alert('Fehler: ' + (err.error || resp.statusText));
        }

        async function deleteEntry(kind, id) {
            if (!confirm('Eintrag wirklich entfernen?')) return;
            const resp = await fetch('/api/' + ENTRY_ENDPOINTS[kind] + '/' + id, {
                method: 'DELETE',
                headers: { 'X-CSRF-Token': CSRF_TOKEN }
            });
            if (resp.ok) { location.reload(); return; }
            const err = await resp.json().catch(() => ({}));
            alert('Fehler: ' + (err.error || resp.statusText));
        }

        // --- Gemeinsames Modal fuer Bearbeiten und Anlegen ---

        function openEntry(rawEntry) {
            const entry = JSON.parse(rawEntry);
            const modal = document.getElementById('entryModal');
            if (!modal) return;

            const form = document.getElementById('entryForm');
            form.elements.kind.value = entry.kind;
            form.elements.id.value = entry.id;
            form.elements.text.value = entry.text || '';
            form.elements.description.value = entry.description || '';
            form.elements.name.value = entry.name || '';
            if (form.elements.workflow_id) {
                form.elements.workflow_id.value = entry.workflow_id ? String(entry.workflow_id) : '';
            }

            document.getElementById('entryModalTitle').textContent =
                entry.kind === 'workflows' ? 'Workflow bearbeiten' : 'Eintrag bearbeiten';
            document.getElementById('entryTextLabel').textContent = ENTRY_LABELS[entry.kind] || 'Text';

            // workflows hat nur ein Textfeld; die Beschreibung IST der Text.
            document.getElementById('entryDescriptionRow').classList.toggle('hidden', entry.kind === 'workflows');
            document.getElementById('entryNameRow').classList.toggle('hidden', entry.kind !== 'workflows');
            document.getElementById('entryWorkflowRow').classList.toggle('hidden', entry.kind === 'workflows');

            document.getElementById('entryOrigin').textContent = entry.meeting
                ? `Herkunft: Termin "${entry.meeting}"`
                : 'Herkunft: direkt im Projekt erfasst';

            modal.classList.remove('hidden');
            modal.classList.add('flex');
            (entry.kind === 'workflows' ? form.elements.name : form.elements.text).focus();
        }

        // Neuer Workflow: gleiches Formular, aber ohne id -> POST statt PATCH.
        function openNewWorkflow() {
            const modal = document.getElementById('entryModal');
            if (!modal) return;

            const form = document.getElementById('entryForm');
            form.reset();
            form.elements.kind.value = 'workflows';
            form.elements.id.value = '';

            document.getElementById('entryModalTitle').textContent = 'Neuer Workflow';
            document.getElementById('entryTextLabel').textContent = 'Beschreibung';
            document.getElementById('entryDescriptionRow').classList.add('hidden');
            document.getElementById('entryNameRow').classList.remove('hidden');
            document.getElementById('entryWorkflowRow').classList.add('hidden');
            document.getElementById('entryOrigin').textContent =
                'Der Workflow wird direkt im Projekt erfasst.';

            modal.classList.remove('hidden');
            modal.classList.add('flex');
            form.elements.name.focus();
        }

        function closeEntry() {
            const modal = document.getElementById('entryModal');
            if (!modal) return;
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        document.getElementById('entryForm')?.addEventListener('submit', async (event) => {
            event.preventDefault();
            const form = event.target;
            const kind = form.elements.kind.value;
            const id = form.elements.id.value;
            const endpoint = ENTRY_ENDPOINTS[kind];
            if (!endpoint) return;

            const payload = {};
            payload[ENTRY_TEXT_FIELDS[kind]] = form.elements.text.value;
            if (kind !== 'workflows') {
                payload.description = form.elements.description.value;
                if (form.elements.workflow_id) {
                    payload.workflow_id = form.elements.workflow_id.value
                        ? Number(form.elements.workflow_id.value)
                        : null;
                }
            }
            if (kind === 'workflows') payload.name = form.elements.name.value;

            const button = document.getElementById('entrySaveButton');
            button.disabled = true;
            try {
                // Ohne id wird ein neuer Eintrag angelegt.
                const url = id ? '/api/' + endpoint + '/' + id : '/api/projects/' + PROJECT_ID + '/' + endpoint;
                const resp = await fetch(url, {
                    method: id ? 'PATCH' : 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
                    body: JSON.stringify(payload)
                });
                if (resp.ok) { location.reload(); return; }
                const err = await resp.json().catch(() => ({}));
                alert('Fehler: ' + (err.error || resp.statusText));
            } finally {
                button.disabled = false;
            }
        });

        document.getElementById('entryModal')?.addEventListener('click', (event) => {
            if (event.target.id === 'entryModal') closeEntry();
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') closeEntry();
        });

        // --- Dokumente ---

        document.querySelectorAll('.file-upload-form').forEach((form) => {
            form.addEventListener('submit', async (event) => {
                event.preventDefault();
                const input = form.querySelector('input[type="file"]');
                if (!input || !input.files || input.files.length === 0) return;

                const button = form.querySelector('button[type="submit"]');
                if (button) button.disabled = true;
                try {
                    const body = new FormData();
                    for (const file of input.files) body.append('attachments', file);
                    if (form.elements.workflow_id && form.elements.workflow_id.value) {
                        body.append('workflow_id', form.elements.workflow_id.value);
                    }
                    if (form.elements.phase) body.append('phase', form.elements.phase.value);

                    const resp = await fetch('/api/projects/' + PROJECT_ID + '/attachments', {
                        method: 'POST',
                        headers: { 'X-CSRF-Token': CSRF_TOKEN },
                        body
                    });
                    if (resp.ok) { location.reload(); return; }
                    const err = await resp.json().catch(() => ({}));
                    alert('Fehler: ' + (err.error || resp.statusText));
                } finally {
                    if (button) button.disabled = false;
                }
            });
        });

        // --- Diagramm ueberarbeiten (Anpassungswunsch) ---

        document.querySelectorAll('.bpmn-refine-form').forEach((form) => {
            form.addEventListener('submit', async (event) => {
                event.preventDefault();
                const summaryId = Number(form.dataset.summaryId);
                const instruction = (form.elements.instruction.value || '').trim();
                if (!summaryId || !instruction) { form.elements.instruction.focus(); return; }

                if (!confirm('Diagramm anhand des Wunsches überarbeiten? Das kann einige Sekunden dauern.')) return;

                const root = form.closest('[data-flow-group]');
                const staffSelect = root ? root.querySelector('[data-summary-staff]') : null;
                const button = form.querySelector('button[type="submit"]');
                if (button) { button.disabled = true; button.textContent = 'Überarbeite…'; }
                try {
                    const resp = await fetch('/api/projects/' + PROJECT_ID + '/flow-summary/' + summaryId + '/bpmn-refine', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
                        body: JSON.stringify({
                            instruction,
                            staff_id: staffSelect && staffSelect.value ? Number(staffSelect.value) : undefined,
                            orientation: form.dataset.orientation || undefined
                        })
                    });
                    const data = await resp.json().catch(() => ({}));
                    if (!resp.ok) { alert('Fehler: ' + (data.error || resp.statusText)); return; }
                    location.reload();
                } finally {
                    if (button) { button.disabled = false; button.textContent = 'Überarbeiten'; }
                }
            });
        });

        async function deleteFile(id) {
            if (!confirm('Datei wirklich entfernen?')) return;
            const resp = await fetch('/api/projects/' + PROJECT_ID + '/attachments/' + id, {
                method: 'DELETE',
                headers: { 'X-CSRF-Token': CSRF_TOKEN }
            });
            if (resp.ok) { location.reload(); return; }
            const err = await resp.json().catch(() => ({}));
            alert('Fehler: ' + (err.error || resp.statusText));
        }

        // --- KI-Zusammenfassung je Workflow ---

        // Zeigt, was an das Modell gehen wuerde - ohne Aufruf und ohne Kosten.
        async function previewSummary(key) {
            const workflowId = workflowIdOf(key);
            const resp = await fetch('/api/projects/' + PROJECT_ID + '/flow-summary', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
                body: JSON.stringify({ dry_run: true, workflow_id: workflowId || undefined })
            });
            const data = await resp.json().catch(() => ({}));
            if (!resp.ok) { alert('Fehler: ' + (data.error || resp.statusText)); return; }

            const s = data.stats || {};
            const lines = [
                `Transkripte: ${s.transcripts || 0}`,
                `Dokumente: ${s.files || 0} (lesbar: ${s.readableFiles || 0})`,
                `Workflows: ${s.workflows || 0}`,
                `Probleme: ${s.problems || 0}`,
                `Adoptionsrisiken: ${s.adoptionRisks || 0}`,
                `Eingabe: ${s.inputChars || 0} Zeichen${data.truncated ? ' (gekuerzt)' : ''}`,
                `Redigiert: ${(data.redaction_hits || []).length} Treffer`
            ];
            alert('Vorschau der Eingabe\n\n' + lines.join('\n') + '\n\nDer vollstaendige Text steht in der Browser-Konsole.');
            console.log('[flow-summary] Eingabe:\n' + data.input);
            if ((data.redaction_hits || []).length) {
                console.log('[flow-summary] Redaction:', data.redaction_hits);
            }
        }

        async function createSummary(key) {
            const root = groupRoot(key);
            const button = root ? root.querySelector('[data-summary-create]') : null;
            if (!confirm('Zusammenfassung durch das Modell erstellen? Das kann einige Sekunden dauern.')) return;

            const workflowId = workflowIdOf(key);
            const staffSelect = root ? root.querySelector('[data-summary-staff]') : null;
            const landscape = root ? root.querySelector('[data-summary-landscape]') : null;

            if (button) { button.disabled = true; button.textContent = 'Erstelle…'; }
            try {
                const resp = await fetch('/api/projects/' + PROJECT_ID + '/flow-summary', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
                    body: JSON.stringify({
                        staff_id: staffSelect && staffSelect.value ? Number(staffSelect.value) : undefined,
                        orientation: landscape && landscape.checked ? 'landscape' : 'portrait',
                        workflow_id: workflowId || undefined
                    })
                });
                const data = await resp.json().catch(() => ({}));
                if (!resp.ok) { alert('Fehler: ' + (data.error || resp.statusText)); return; }
                location.reload();
            } finally {
                if (button) { button.disabled = false; button.textContent = 'Zusammenfassung erstellen'; }
            }
        }

        // --- BPMN-Diagramme (Ist-Zustand, je Workflow) ---

        const BPMN_DIAGRAMS = <%- JSON.stringify(bpmnDiagrams).replace(/</g, '\\u003c') %>;

        (function initBpmnDiagrams() {
            if (!BPMN_DIAGRAMS.length) return;

            const Viewer = window.BpmnJS || window.BpmnNavigatedViewer || window.BpmnViewer;
            if (!Viewer) {
                console.warn('[bpmn] bpmn-js nicht geladen');
                return;
            }

            BPMN_DIAGRAMS.forEach((diagram) => {
                const root = groupRoot(diagram.key);
                const canvas = root ? root.querySelector('[data-bpmn-canvas]') : null;
                if (!canvas) return;

                const viewer = new Viewer({ container: canvas });
                viewer.importXML(diagram.xml)
                    .then(() => {
                        viewer.get('canvas').zoom('fit-viewport', 20);
                        decoratePrograms(viewer, root);
                    })
                    .catch((err) => {
                        console.warn('[bpmn] Import fehlgeschlagen:', err);
                        canvas.textContent = 'Diagramm konnte nicht gerendert werden.';
                    });

                // Die Visualisierung liegt in einklappbaren <details>. bpmn-js
                // kann die Groesse erst messen, wenn der Abschnitt sichtbar ist.
                const refreshSize = () => {
                    if (!canvas.offsetParent) return;
                    try {
                        viewer.get('canvas').resized();
                        viewer.get('canvas').zoom('fit-viewport', 20);
                    } catch (err) {
                        console.warn('[bpmn] resize fehlgeschlagen:', err);
                    }
                };
                [canvas.closest('[data-flow-group]'), canvas.closest('details')]
                    .filter((el) => el && el.tagName === 'DETAILS')
                    .forEach((el) => el.addEventListener('toggle', () => setTimeout(refreshSize, 0)));

                const downloadLink = root.querySelector('[data-bpmn-download]');
                if (downloadLink) {
                    downloadLink.addEventListener('click', (event) => {
                        event.preventDefault();
                        viewer.saveXML().then(({ xml }) => {
                            const blob = new Blob([xml], { type: 'application/xml' });
                            const url = URL.createObjectURL(blob);
                            const a = document.createElement('a');
                            a.href = url;
                            a.download = 'flow-ist-zustand.bpmn';
                            document.body.appendChild(a);
                            a.click();
                            a.remove();
                            URL.revokeObjectURL(url);
                        }).catch(() => alert('XML-Export nicht möglich.'));
                    });
                }

                const saveButton = root.querySelector('[data-bpmn-save]');
                if (saveButton) {
                    saveButton.addEventListener('click', () => {
                        if (!diagram.summaryId) { alert('Keine Zusammenfassung zum Speichern vorhanden.'); return; }
                        viewer.saveXML().then(({ xml }) => {
                            saveButton.disabled = true;
                            saveButton.textContent = 'Speichere…';
                            return fetch('/api/projects/' + PROJECT_ID + '/flow-summary/' + diagram.summaryId + '/bpmn', {
                                method: 'PATCH',
                                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
                                body: JSON.stringify({ bpmn_xml: xml })
                            }).then((resp) => resp.json().then((data) => ({ ok: resp.ok, data })));
                        }).then(({ ok, data }) => {
                            if (!ok) throw new Error(data.error || 'Speichern fehlgeschlagen.');
                            alert('Diagramm gespeichert.');
                        }).catch((err) => {
                            alert('Fehler: ' + (err.message || err));
                        }).finally(() => {
                            saveButton.disabled = false;
                            saveButton.textContent = 'Speichern';
                        });
                    });
                }

                const printButton = root.querySelector('[data-bpmn-print]');
                if (printButton) {
                    printButton.addEventListener('click', () => {
                        if (typeof viewer.saveSVG !== 'function') {
                            alert('Drucken wird von dieser bpmn-js-Variante nicht unterstützt.');
                            return;
                        }
                        viewer.saveSVG().then(({ svg }) => {
                            const win = window.open('', '_blank');
                            if (!win) { alert('Pop-up blockiert — bitte erlauben.'); return; }
                            const pageSize = diagram.xml.includes('isHorizontal="true"')
                                ? 'A4 landscape' : 'A4 portrait';
                            win.document.write(
                                '<!DOCTYPE html><html><head><meta charset="utf-8"><title>Flow-Diagramm</title>' +
                                '<style>@page { size: ' + pageSize + '; margin: 10mm; }' +
                                'html, body { margin: 0; padding: 0; }' +
                                'svg { width: 100%; height: 100%; }</style></head><body>' +
                                svg + '</body></html>'
                            );
                            win.document.close();
                            win.focus();
                            win.onload = () => win.print();
                        }).catch((err) => {
                            console.warn('[bpmn] saveSVG fehlgeschlagen:', err);
                            alert('Drucken nicht möglich.');
                        });
                    });
                }
            });
        })();

        // Zeigt je Aufgabe das eingesetzte Programm als Badge an und baut
        // daraus eine Legende. Die Farbe stammt aus dem XML (bioc:fill),
        // der Programmname aus der <bpmn:documentation> ("Programm: X").
        function decoratePrograms(viewer, root) {
            const elementRegistry = viewer.get('elementRegistry');
            const overlays = viewer.get('overlays');
            const programColors = new Map();

            const escapeHtml = (s) => String(s).replace(/[&<>"']/g, (c) => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            }[c]));

            const programOf = (businessObject) => {
                const text = (businessObject.documentation || [])
                    .map((d) => d.text || '')
                    .join('\n');
                const m = text.match(/Programm:\s*([^\r\n]+)/i);
                return m ? m[1].trim() : null;
            };

            elementRegistry.getAll().forEach((el) => {
                const bo = el.businessObject;
                if (!bo || !bo.$instanceOf || !bo.$instanceOf('bpmn:Task')) return;
                const program = programOf(bo);
                if (!program) return;

                let color = '#e5e7eb';
                if (el.di && typeof el.di.get === 'function') {
                    color = el.di.get('bioc:fill') || color;
                }
                if (!programColors.has(program)) programColors.set(program, color);

                overlays.add(el.id, {
                    position: { bottom: -6, left: 0 },
                    html: '<div class="bpmn-program-badge" style="background:' + color + '">' +
                        escapeHtml(program) + '</div>'
                });
            });

            const legend = root.querySelector('[data-bpmn-legend]');
            if (!legend || programColors.size === 0) return;
            legend.innerHTML = '';
            programColors.forEach((color, program) => {
                const item = document.createElement('span');
                item.className = 'bpmn-legend-item';
                item.innerHTML = '<span class="bpmn-legend-swatch" style="background:' + color + '"></span>' +
                    escapeHtml(program);
                legend.appendChild(item);
            });
        }
    </script>
</body>
</html>
