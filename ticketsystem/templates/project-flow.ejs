<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flow Analysis - <%= project.name %> | Ticketsystem</title>
    <link rel="stylesheet" href="/style.css?v=2">
    <link rel="stylesheet" href="/bpmn-js/assets/diagram-js.css">
    <link rel="stylesheet" href="/bpmn-js/assets/bpmn-js.css">
    <link rel="stylesheet" href="/bpmn-js/assets/bpmn-font/css/bpmn.css">
</head>
<body class="bg-gray-50 min-h-screen">
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <div class="flex-shrink-0 flex items-center gap-2">
                        <div class="w-8 h-8 bg-primary-600 rounded-lg flex items-center justify-center">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
                            </svg>
                        </div>
                        <a href="/" class="text-xl font-bold text-gray-900 hover:text-primary-600">Ticketsystem</a>
                    </div>
                    <div class="hidden md:ml-8 md:flex md:space-x-1">
                        <a href="/" class="nav-link">Dashboard</a>
                        <a href="/features" class="nav-link">Features</a>
                        <a href="/ticket/new" class="nav-link">Neues Ticket</a>
                        <a href="/projects" class="nav-link active">Projekte</a>
                        <% if (role === 'admin' || role === 'root') { %>
                        <a href="/stats" class="nav-link">Statistiken</a>
                        <a href="/admin/systems" class="nav-link">Systeme</a>
                        <a href="/admin/staff" class="nav-link">Mitarbeiter</a>
                        <% if (role === 'root') { %><a href="/admin/users" class="nav-link">Benutzer</a><% } %>
                        <% } %>
                    </div>
                </div>
                <div class="flex items-center gap-2 sm:gap-4">
                    <span class="hidden sm:inline text-sm text-gray-600"><%= user %> <span class="badge bg-gray-100 text-gray-700"><%= role %></span></span>
                    <a href="/account" class="hidden sm:inline-flex btn-secondary text-sm">Account</a>
                    <a href="/logout" class="hidden sm:inline-flex btn-secondary text-sm">Abmelden</a>
                    <button type="button" id="mobileNavToggle" class="md:hidden btn-secondary text-sm px-3 py-2" aria-label="Menü öffnen" aria-controls="mobileNav" aria-expanded="false">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
        <%- include('partials/mobile-nav') %>
    </nav>

    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <nav class="flex items-center gap-2 text-sm mb-4">
            <a href="/projects" class="text-gray-500 hover:text-gray-700">Projekte</a>
            <span class="text-gray-400">/</span>
            <a href="/project/<%= project.id %>" class="text-gray-500 hover:text-gray-700"><%= project.name %></a>
            <span class="text-gray-400">/</span>
            <span class="text-gray-900 font-medium">Flow Analysis</span>
        </nav>

        <div class="mb-6">
            <h1 class="text-2xl font-bold text-gray-900">Flow Analysis</h1>
            <p class="text-sm text-gray-500 mt-1">
                <%= project.name %><% if (project.system_name) { %> · <%= project.system_name %><% } %><% if (project.department_name) { %> · <%= project.hospital_name ? project.hospital_name + ' · ' : '' %><%= project.department_name %><% } %>
            </p>
            <p class="text-sm text-gray-600 mt-2">
                Bestehenden Workflow erfassen, Probleme sammeln und daraus den Zielzustand ableiten.
            </p>
        </div>

        <%- include('partials/project-nav', { active: 'flow' }) %>

        <!-- ========== INPUT ========== -->
        <section class="mb-10">
            <div class="flex items-center gap-2 mb-3">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-primary-600 text-sm font-semibold text-white">1</span>
                <h2 class="text-lg font-semibold text-gray-900">Input</h2>
                <span class="text-sm text-gray-400">Bestandsaufnahme</span>
            </div>
            <p class="text-sm text-gray-600 mb-4">
                Alles, was den heutigen Ablauf beschreibt: Gespräche, Dokumente und die daraus erkannten Probleme.
            </p>

            <!-- Termine mit Transkript -->
            <div class="card mb-4">
                <div class="card-header"><h3 class="text-base font-semibold text-gray-900">Transkripte aus Terminen</h3></div>
                <div class="card-body">
                    <% if (transcripts.length === 0) { %>
                    <p class="text-sm text-gray-500">
                        Noch keine Transkripte erfasst.
                        <a href="/project/<%= project.id %>/meetings" class="text-primary-600 hover:text-primary-800">Zu den Terminen</a>
                    </p>
                    <% } else { %>
                    <ul class="divide-y divide-gray-100">
                        <% transcripts.forEach(t => { %>
                        <li class="flex flex-wrap items-center justify-between gap-2 py-2">
                            <div class="min-w-0">
                                <p class="text-sm font-medium text-gray-900"><%= t.title %></p>
                                <p class="text-xs text-gray-500">
                                    <%= t.meeting_date %><% if (t.start_time) { %> · <%= t.start_time %> Uhr<% } %>
                                    · <%= t.transcript_length %> Zeichen
                                </p>
                            </div>
                            <a href="/project/<%= project.id %>/meetings" class="text-sm text-primary-600 hover:text-primary-800">Ansehen</a>
                        </li>
                        <% }); %>
                    </ul>
                    <% } %>
                </div>
            </div>

            <!-- Dateien -->
            <div class="card mb-4">
                <div class="card-header"><h3 class="text-base font-semibold text-gray-900">Dokumente</h3></div>
                <div class="card-body">
                    <% const inputFiles = attachments.filter(a => a.phase !== 'output'); %>
                    <% if (inputFiles.length === 0) { %>
                    <p class="text-sm text-gray-500">Noch keine Dateien hochgeladen.</p>
                    <% } else { %>
                    <ul class="divide-y divide-gray-100">
                        <% inputFiles.forEach(a => { %>
                        <li class="flex flex-wrap items-center justify-between gap-2 py-2">
                            <div class="min-w-0">
                                <a href="/uploads/projects/<%= a.filename %>" target="_blank" rel="noopener"
                                   class="text-sm font-medium text-primary-600 hover:text-primary-800 break-all"><%= a.original_name %></a>
                                <p class="text-xs text-gray-500">
                                    <%= (a.size / 1024).toFixed(0) %> KB · <%= a.created_by || 'unbekannt' %>
                                </p>
                            </div>
                            <% if (canManage) { %>
                            <button type="button" class="text-sm text-red-600 hover:text-red-900" onclick="deleteFile(<%= a.id %>)">entfernen</button>
                            <% } %>
                        </li>
                        <% }); %>
                    </ul>
                    <% } %>

                    <% if (canManage) { %>
                    <form id="fileUploadForm" class="mt-4 flex flex-col gap-2 border-t border-gray-100 pt-4 sm:flex-row sm:items-center">
                        <input type="file" name="attachments" multiple
                               class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-primary-50 file:text-primary-700 hover:file:bg-primary-100">
                        <button type="submit" id="fileUploadButton" class="btn-primary text-sm whitespace-nowrap">Hochladen</button>
                    </form>
                    <p class="mt-1 text-xs text-gray-400">PDF, Word, Excel, Bilder oder Text – max. 20 MB pro Datei, 10 Dateien pro Upload.</p>
                    <% } %>
                </div>
            </div>

            <!-- KI-Zusammenfassung der Bestandsaufnahme -->
            <div class="card mb-4">
                <div class="card-header flex flex-wrap items-center justify-between gap-2">
                    <h3 class="text-base font-semibold text-gray-900">Zusammenfassung (KI)</h3>
                    <% if (summaries.length > 0) { %>
                    <span class="text-xs text-gray-500">
                        <%= summaries[0].model || summaries[0].provider || 'unbekannt' %> ·
                        <%= formatDateTime(summaries[0].created_at) %>
                    </span>
                    <% } %>
                </div>
                <div class="card-body">
                    <% const latestSummary = summaries[0] || null; %>
                    <% if (latestSummary) { %>
                    <div class="rounded-lg border border-gray-100 bg-gray-50 px-3 py-3">
                        <p class="whitespace-pre-wrap break-words text-sm text-gray-800"><%= latestSummary.content %></p>
                    </div>
                    <p class="mt-2 text-xs text-gray-500">
                        Eingabe: <%= latestSummary.input_chars || 0 %> Zeichen
                        <% if (latestSummary.prompt_tokens) { %>· <%= latestSummary.prompt_tokens %> Prompt-Token<% } %>
                        <% if (latestSummary.completion_tokens) { %>· <%= latestSummary.completion_tokens %> Antwort-Token<% } %>
                        <% if (latestSummary.created_by) { %>· von <%= latestSummary.created_by %><% } %>
                    </p>
                    <% if (latestSummary.bpmn_xml) { %>
                    <div class="mt-4">
                        <div class="mb-2 flex items-center justify-between gap-2">
                            <h4 class="text-sm font-semibold text-gray-700">Flow-Diagramm (Ist-Zustand)</h4>
                            <a href="#" id="bpmnDownload" class="text-xs text-primary-700 hover:underline">BPMN-XML herunterladen</a>
                        </div>
                        <div id="bpmnCanvas" class="h-96 w-full overflow-hidden rounded-lg border border-gray-200 bg-white"></div>
                        <p class="mt-2 text-xs text-gray-500">Automatisch aus der Bestandsaufnahme generiert.</p>
                    </div>
                    <% } %>
                    <% } else { %>
                    <p class="text-sm text-gray-500">Noch keine Zusammenfassung erstellt.</p>
                    <% } %>

                    <% if (canManage) { %>
                    <div class="mt-4 flex flex-col gap-2 border-t border-gray-100 pt-4 sm:flex-row sm:items-end">
                        <div class="flex-1">
                            <label for="summaryStaff" class="mb-1 block text-xs font-medium text-gray-500">Modell</label>
                            <select id="summaryStaff" class="form-select text-sm">
                                <% aiStaff.forEach(bot => { %>
                                <option value="<%= bot.id %>"><%= bot.name %><% if (bot.ai_model) { %> (<%= bot.ai_model %>)<% } %></option>
                                <% }); %>
                            </select>
                            <% if (aiStaff.length === 0) { %>
                            <p class="mt-1 text-xs text-amber-700">Kein KI-Mitarbeiter konfiguriert.</p>
                            <% } %>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <button type="button" class="btn-secondary text-sm" onclick="previewSummary()">Vorschau</button>
                            <button type="button" id="summaryButton" class="btn-primary text-sm"
                                <%= aiStaff.length === 0 ? 'disabled' : '' %>
                                onclick="createSummary()">Zusammenfassung erstellen</button>
                        </div>
                    </div>
                    <% if (latestSummary) { %>
                    <p class="mt-2 text-xs text-gray-400">
                        Eine neue Zusammenfassung ersetzt die bisherige Anzeige; ältere Versionen bleiben gespeichert.
                    </p>
                    <% } %>
                    <% } %>

                    <% if (summaries.length > 1) { %>
                    <details class="mt-3">
                        <summary class="cursor-pointer text-sm text-primary-700">Ältere Versionen (<%= summaries.length - 1 %>)</summary>
                        <ul class="mt-2 divide-y divide-gray-100">
                            <% summaries.slice(1).forEach(s => { %>
                            <li class="py-2">
                                <p class="text-xs text-gray-500">
                                    <%= formatDateTime(s.created_at) %> · <%= s.model || s.provider || 'unbekannt' %>
                                    · <%= s.input_chars || 0 %> Zeichen Eingabe
                                </p>
                                <p class="mt-1 whitespace-pre-wrap break-words text-sm text-gray-700"><%= s.content %></p>
                            </li>
                            <% }); %>
                        </ul>
                    </details>
                    <% } %>
                </div>
            </div>

            <!-- Erkenntnisse -->
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
                <%
                const groups = [
                    { kind: 'workflows', title: 'Workflow (Ist-Zustand)', placeholder: 'Wie läuft der Prozess heute ab?', label: 'Beschreibung' },
                    { kind: 'problems', title: 'Probleme', placeholder: 'Was funktioniert heute nicht?', label: 'Titel' },
                    { kind: 'adoptionRisks', title: 'Adoptionsrisiken', placeholder: 'Warum könnte die Abteilung nicht wechseln wollen?', label: 'Titel' }
                ];
                %>
                <% groups.forEach(group => { const list = entries[group.kind] || []; %>
                <div class="card">
                    <div class="card-header flex items-center justify-between gap-2">
                        <h3 class="text-base font-semibold text-gray-900"><%= group.title %></h3>
                        <span class="text-sm text-gray-400"><%= list.length %></span>
                    </div>
                    <div class="card-body">
                        <% if (list.length === 0) { %>
                        <p class="text-sm text-gray-500">Noch nichts erfasst.</p>
                        <% } else { %>
                        <ul class="space-y-2">
                            <% list.forEach(item => { %>
                            <li class="rounded-lg border border-gray-100 bg-gray-50 px-3 py-2">
                                <p class="whitespace-pre-wrap break-words text-sm text-gray-800"><%= item.text %></p>
                                <% if (canManage) { %>
                                <p class="mt-1 flex flex-wrap items-center gap-2 text-xs text-gray-500">
                                    <% if (item.meeting_title) { %>
                                    <span>aus: <a href="/project/<%= project.id %>/meetings" class="text-primary-600 hover:text-primary-800"><%= item.meeting_title %></a></span>
                                    <% } else { %>
                                    <span class="badge bg-gray-200 text-gray-700">direkt erfasst</span>
                                    <% } %>
                                    <button type="button" class="text-primary-600 hover:text-primary-800"
                                        data-entry='<%- JSON.stringify({ kind: group.kind, id: item.id, text: item.text || '', description: item.description || '', meeting: item.meeting_title || '' }).replace(/'/g, "&#39;") %>'
                                        onclick='openEntry(this.dataset.entry)'>bearbeiten</button>
                                    <button type="button" class="text-red-600 hover:text-red-900" onclick="deleteEntry('<%= group.kind %>', <%= item.id %>)">entfernen</button>
                                </p>
                                <% } else if (item.meeting_title) { %>
                                <p class="mt-1 text-xs text-gray-500">aus: <%= item.meeting_title %></p>
                                <% } %>
                            </li>
                            <% }); %>
                        </ul>
                        <% } %>

                        <% if (canManage) { %>
                        <form class="mt-3 flex flex-col gap-2 border-t border-gray-100 pt-3" onsubmit="addEntry(event, '<%= group.kind %>')">
                            <textarea name="value" rows="2" required class="form-input text-sm" placeholder="<%= group.placeholder %>"></textarea>
                            <button type="submit" class="btn-secondary text-sm">Hinzufügen</button>
                        </form>
                        <% } %>
                    </div>
                </div>
                <% }); %>
            </div>
        </section>

        <!-- ========== INPUT-VISUALISIERUNG ========== -->
        <section class="mb-10">
            <div class="flex items-center gap-2 mb-3">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-gray-300 text-sm font-semibold text-white">2</span>
                <h2 class="text-lg font-semibold text-gray-900">Input-Visualisierung</h2>
                <span class="badge bg-amber-100 text-amber-800 text-xs">geplant</span>
            </div>
            <div class="card border-2 border-dashed border-gray-200 bg-white/60">
                <div class="card-body text-sm text-gray-600">
                    <p>Aus den Eingaben soll ein Modell den bestehenden Workflow aufzeichnen und die erfassten Probleme darin markieren.</p>
                    <p class="mt-2 text-gray-500">
                        Voraussetzung: die Erfassung oben ist vollständig genug, um Ablauf und Probleme abzubilden.
                    </p>
                </div>
            </div>
        </section>

        <!-- ========== OUTPUT ========== -->
        <section class="mb-10">
            <div class="flex items-center gap-2 mb-3">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-gray-300 text-sm font-semibold text-white">3</span>
                <h2 class="text-lg font-semibold text-gray-900">Output</h2>
                <span class="badge bg-amber-100 text-amber-800 text-xs">geplant</span>
            </div>
            <div class="card border-2 border-dashed border-gray-200 bg-white/60">
                <div class="card-body text-sm text-gray-600">
                    <p>Der Zielzustand: ein Workflow, der mit der neuen Software möglich ist — als Vorschlag aus den erfassten Problemen.</p>
                    <p class="mt-2 text-gray-500">
                        Zusätzlich sollen Screenshots und Beschreibungen der fertigen Integration hier abgelegt werden können.
                    </p>
                </div>
            </div>
        </section>
    </main>

    <% if (canManage) { %>
    <div id="entryModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
        <div class="w-full max-w-2xl rounded-lg bg-white shadow-xl">
            <div class="flex items-center justify-between gap-3 border-b border-gray-200 px-4 py-3">
                <h3 id="entryModalTitle" class="text-base font-semibold text-gray-900">Eintrag bearbeiten</h3>
                <button type="button" class="text-gray-400 hover:text-gray-600" onclick="closeEntry()" aria-label="Schliessen">&times;</button>
            </div>
            <form id="entryForm" class="space-y-3 px-4 py-4">
                <input type="hidden" name="kind" value="">
                <input type="hidden" name="id" value="">
                <div>
                    <label id="entryTextLabel" class="mb-1 block text-sm font-medium text-gray-700">Text</label>
                    <textarea name="text" rows="8" required class="form-input"></textarea>
                </div>
                <div id="entryDescriptionRow">
                    <label class="mb-1 block text-sm font-medium text-gray-700">Beschreibung</label>
                    <textarea name="description" rows="4" class="form-input" placeholder="Zusaetzliche Details, optional"></textarea>
                </div>
                <p id="entryOrigin" class="text-xs text-gray-500"></p>
                <div class="flex items-center gap-3 border-t border-gray-100 pt-3">
                    <button type="submit" id="entrySaveButton" class="btn-primary text-sm">Speichern</button>
                    <button type="button" class="btn-secondary text-sm" onclick="closeEntry()">Abbrechen</button>
                </div>
            </form>
        </div>
    </div>
    <% } %>

    <% if (summaries[0] && summaries[0].bpmn_xml) { %>
    <script src="/bpmn-js/bpmn-navigated-viewer.production.min.js"></script>
    <% } %>
    <script>
        const CSRF_TOKEN = '<%= csrfToken %>';
        const PROJECT_ID = <%= project.id %>;

        const ENTRY_FIELDS = {
            workflows: 'description',
            problems: 'title',
            adoptionRisks: 'title'
        };
        const ENTRY_ENDPOINTS = {
            workflows: 'workflows',
            problems: 'problems',
            adoptionRisks: 'adoption-risks'
        };

        async function addEntry(event, kind) {
            event.preventDefault();
            const form = event.target;
            const value = (form.elements.value.value || '').trim();
            if (!value) { form.elements.value.focus(); return; }

            const payload = {};
            payload[ENTRY_FIELDS[kind]] = value;

            const resp = await fetch('/api/projects/' + PROJECT_ID + '/' + ENTRY_ENDPOINTS[kind], {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
                body: JSON.stringify(payload)
            });
            if (resp.ok) { location.reload(); return; }
            const err = await resp.json().catch(() => ({}));
            alert('Fehler: ' + (err.error || resp.statusText));
        }

        async function deleteEntry(kind, id) {
            if (!confirm('Eintrag wirklich entfernen?')) return;
            const resp = await fetch('/api/' + ENTRY_ENDPOINTS[kind] + '/' + id, {
                method: 'DELETE',
                headers: { 'X-CSRF-Token': CSRF_TOKEN }
            });
            if (resp.ok) { location.reload(); return; }
            const err = await resp.json().catch(() => ({}));
            alert('Fehler: ' + (err.error || resp.statusText));
        }

        // --- Eintrag oeffnen und bearbeiten ---

        const ENTRY_TEXT_FIELDS = { workflows: 'description', problems: 'title', adoptionRisks: 'title' };
        const ENTRY_LABELS = {
            workflows: 'Beschreibung',
            problems: 'Titel',
            adoptionRisks: 'Titel'
        };

        function openEntry(rawEntry) {
            const entry = JSON.parse(rawEntry);
            const modal = document.getElementById('entryModal');
            if (!modal) return;

            const form = document.getElementById('entryForm');
            form.elements.kind.value = entry.kind;
            form.elements.id.value = entry.id;
            form.elements.text.value = entry.text || '';
            form.elements.description.value = entry.description || '';

            document.getElementById('entryModalTitle').textContent =
                entry.kind === 'workflows' ? 'Workflow bearbeiten' : 'Eintrag bearbeiten';
            document.getElementById('entryTextLabel').textContent = ENTRY_LABELS[entry.kind] || 'Text';

            // workflows hat nur ein Textfeld; die Beschreibung IST der Text.
            const descriptionRow = document.getElementById('entryDescriptionRow');
            descriptionRow.classList.toggle('hidden', entry.kind === 'workflows');

            document.getElementById('entryOrigin').textContent = entry.meeting
                ? `Herkunft: Termin "${entry.meeting}"`
                : 'Herkunft: direkt im Projekt erfasst';

            modal.classList.remove('hidden');
            modal.classList.add('flex');
            form.elements.text.focus();
        }

        function closeEntry() {
            const modal = document.getElementById('entryModal');
            if (!modal) return;
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        document.getElementById('entryForm')?.addEventListener('submit', async (event) => {
            event.preventDefault();
            const form = event.target;
            const kind = form.elements.kind.value;
            const id = form.elements.id.value;
            const endpoint = ENTRY_ENDPOINTS[kind];
            if (!endpoint || !id) return;

            const payload = {};
            payload[ENTRY_TEXT_FIELDS[kind]] = form.elements.text.value;
            if (kind !== 'workflows') payload.description = form.elements.description.value;

            const button = document.getElementById('entrySaveButton');
            button.disabled = true;
            try {
                const resp = await fetch('/api/' + endpoint + '/' + id, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
                    body: JSON.stringify(payload)
                });
                if (resp.ok) { location.reload(); return; }
                const err = await resp.json().catch(() => ({}));
                alert('Fehler: ' + (err.error || resp.statusText));
            } finally {
                button.disabled = false;
            }
        });

        document.getElementById('entryModal')?.addEventListener('click', (event) => {
            if (event.target.id === 'entryModal') closeEntry();
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') closeEntry();
        });

        document.getElementById('fileUploadForm')?.addEventListener('submit', async (event) => {
            event.preventDefault();
            const form = event.target;
            const input = form.querySelector('input[type="file"]');
            if (!input || !input.files || input.files.length === 0) return;

            const button = document.getElementById('fileUploadButton');
            button.disabled = true;
            try {
                const body = new FormData();
                for (const file of input.files) body.append('attachments', file);
                const resp = await fetch('/api/projects/' + PROJECT_ID + '/attachments', {
                    method: 'POST',
                    headers: { 'X-CSRF-Token': CSRF_TOKEN },
                    body
                });
                if (resp.ok) { location.reload(); return; }
                const err = await resp.json().catch(() => ({}));
                alert('Fehler: ' + (err.error || resp.statusText));
            } finally {
                button.disabled = false;
            }
        });

        async function deleteFile(id) {
            if (!confirm('Datei wirklich entfernen?')) return;
            const resp = await fetch('/api/projects/' + PROJECT_ID + '/attachments/' + id, {
                method: 'DELETE',
                headers: { 'X-CSRF-Token': CSRF_TOKEN }
            });
            if (resp.ok) { location.reload(); return; }
            const err = await resp.json().catch(() => ({}));
            alert('Fehler: ' + (err.error || resp.statusText));
        }

        // --- KI-Zusammenfassung ---

        function summaryStaffId() {
            const select = document.getElementById('summaryStaff');
            return select && select.value ? Number(select.value) : undefined;
        }

        // Zeigt, was an das Modell gehen wuerde - ohne Aufruf und ohne Kosten.
        async function previewSummary() {
            const resp = await fetch('/api/projects/' + PROJECT_ID + '/flow-summary', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
                body: JSON.stringify({ dry_run: true })
            });
            const data = await resp.json().catch(() => ({}));
            if (!resp.ok) { alert('Fehler: ' + (data.error || resp.statusText)); return; }

            const s = data.stats || {};
            const lines = [
                `Transkripte: ${s.transcripts || 0}`,
                `Dokumente: ${s.files || 0} (lesbar: ${s.readableFiles || 0})`,
                `Workflows: ${s.workflows || 0}`,
                `Probleme: ${s.problems || 0}`,
                `Adoptionsrisiken: ${s.adoptionRisks || 0}`,
                `Eingabe: ${s.inputChars || 0} Zeichen${data.truncated ? ' (gekuerzt)' : ''}`,
                `Redigiert: ${(data.redaction_hits || []).length} Treffer`
            ];
            alert('Vorschau der Eingabe\n\n' + lines.join('\n') + '\n\nDer vollstaendige Text steht in der Browser-Konsole.');
            console.log('[flow-summary] Eingabe:\n' + data.input);
            if ((data.redaction_hits || []).length) {
                console.log('[flow-summary] Redaction:', data.redaction_hits);
            }
        }

        async function createSummary() {
            const button = document.getElementById('summaryButton');
            if (!confirm('Zusammenfassung durch das Modell erstellen? Das kann einige Sekunden dauern.')) return;
            button.disabled = true;
            button.textContent = 'Erstelle…';
            try {
                const resp = await fetch('/api/projects/' + PROJECT_ID + '/flow-summary', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
                    body: JSON.stringify({ staff_id: summaryStaffId() })
                });
                const data = await resp.json().catch(() => ({}));
                if (!resp.ok) { alert('Fehler: ' + (data.error || resp.statusText)); return; }
                location.reload();
            } finally {
                button.disabled = false;
                button.textContent = 'Zusammenfassung erstellen';
            }
        }

        // --- BPMN-Diagramm (Ist-Zustand) ---

        const BPMN_XML = <%- JSON.stringify((summaries[0] && summaries[0].bpmn_xml) || '').replace(/<\//g, '<\\/') %>;

        (function initBpmnDiagram() {
            const canvas = document.getElementById('bpmnCanvas');
            if (!canvas || !BPMN_XML) return;

            const downloadLink = document.getElementById('bpmnDownload');
            if (downloadLink) {
                downloadLink.addEventListener('click', (e) => {
                    e.preventDefault();
                    const blob = new Blob([BPMN_XML], { type: 'application/xml' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = 'flow-ist-zustand.bpmn';
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    URL.revokeObjectURL(url);
                });
            }

            const Viewer = window.BpmnJS || window.BpmnNavigatedViewer || window.BpmnViewer;
            if (!Viewer) {
                console.warn('[bpmn] bpmn-js nicht geladen');
                canvas.textContent = 'Diagramm-Renderer konnte nicht geladen werden.';
                return;
            }
            const viewer = new Viewer({ container: canvas });
            viewer.importXML(BPMN_XML)
                .then(() => { viewer.get('canvas').zoom('fit-viewport'); })
                .catch((err) => {
                    console.warn('[bpmn] Import fehlgeschlagen:', err);
                    canvas.textContent = 'Diagramm konnte nicht gerendert werden.';
                });
        })();
    </script>
</body>
</html>
