<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Termine - <%= project.name %> | Ticketsystem</title>
    <link rel="stylesheet" href="/style.css?v=2">
</head>
<body class="bg-gray-50 min-h-screen">
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <div class="flex-shrink-0 flex items-center gap-2">
                        <div class="w-8 h-8 bg-primary-600 rounded-lg flex items-center justify-center">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
                            </svg>
                        </div>
                        <a href="/" class="text-xl font-bold text-gray-900 hover:text-primary-600">Ticketsystem</a>
                    </div>
                    <div class="hidden md:ml-8 md:flex md:space-x-1">
                        <a href="/" class="nav-link">Dashboard</a>
                        <a href="/features" class="nav-link">Features</a>
                        <a href="/ticket/new" class="nav-link">Neues Ticket</a>
                        <a href="/projects" class="nav-link active">Projekte</a>
                        <% if (role === 'admin' || role === 'root') { %>
                        <a href="/stats" class="nav-link">Statistiken</a>
                        <a href="/admin/systems" class="nav-link">Systeme</a>
                        <a href="/admin/staff" class="nav-link">Mitarbeiter</a>
                        <% if (role === 'root') { %><a href="/admin/users" class="nav-link">Benutzer</a><% } %>
                        <% } %>
                    </div>
                </div>
                <div class="flex items-center gap-2 sm:gap-4">
                    <span class="hidden sm:inline text-sm text-gray-600"><%= user %> <span class="badge bg-gray-100 text-gray-700"><%= role %></span></span>
                    <a href="/account" class="hidden sm:inline-flex btn-secondary text-sm">Account</a>
                    <a href="/logout" class="hidden sm:inline-flex btn-secondary text-sm">Abmelden</a>
                    <button type="button" id="mobileNavToggle" class="md:hidden btn-secondary text-sm px-3 py-2" aria-label="Menü öffnen" aria-controls="mobileNav" aria-expanded="false">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
        <%- include('partials/mobile-nav') %>
    </nav>

    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <%
        const pad2 = (value) => String(value).padStart(2, '0');

        const durationOf = (meeting) => {
            const minutes = Number(meeting.duration_minutes);
            return Number.isInteger(minutes) && minutes > 0 ? minutes : 60;
        };

        // Lokale (schwebende) Zeit: bewusst ohne Zeitzone, damit Export-Termine
        // im Kalender nicht verschoben werden.
        const meetingDateTime = (meeting, addMinutes) => {
            const date = new Date(`${meeting.meeting_date}T${meeting.start_time || '09:00'}:00`);
            if (Number.isNaN(date.getTime())) return null;
            if (addMinutes) date.setMinutes(date.getMinutes() + addMinutes);
            return date;
        };

        const fmtDateLong = (value) => {
            if (!value) return 'Ohne Datum';
            const date = new Date(`${value}T00:00:00`);
            if (Number.isNaN(date.getTime())) return value;
            return date.toLocaleDateString('de-DE', { weekday: 'short', day: '2-digit', month: '2-digit', year: 'numeric' });
        };

        const dateBadge = (value) => {
            const date = value ? new Date(`${value}T00:00:00`) : null;
            if (!date || Number.isNaN(date.getTime())) return { day: '--', month: 'k.A.', weekday: '' };
            return {
                day: date.toLocaleDateString('de-DE', { day: '2-digit' }),
                month: date.toLocaleDateString('de-DE', { month: 'short' }).replace('.', ''),
                weekday: date.toLocaleDateString('de-DE', { weekday: 'short' }).replace('.', '')
            };
        };

        const fmtTimeRange = (meeting) => {
            const start = meeting.start_time ? meetingDateTime(meeting, 0) : null;
            if (!start) return 'ohne Uhrzeit';
            const end = meetingDateTime(meeting, durationOf(meeting));
            const f = (date) => `${pad2(date.getHours())}:${pad2(date.getMinutes())}`;
            return `${f(start)}–${f(end)} Uhr`;
        };

        const icsLocal = (meeting, addMinutes) => {
            const date = meetingDateTime(meeting, addMinutes);
            if (!date) return '';
            return `${date.getFullYear()}${pad2(date.getMonth() + 1)}${pad2(date.getDate())}`
                + `T${pad2(date.getHours())}${pad2(date.getMinutes())}00`;
        };

        const googleCalendarUrl = (meeting) => {
            const details = [
                meeting.key_user_name ? `Key-User: ${meeting.key_user_name}` : '',
                meeting.agenda ? `Agenda:\n${meeting.agenda}` : '',
                meeting.notes ? `Notizen:\n${meeting.notes}` : ''
            ].filter(Boolean).join('\n\n');
            const params = new URLSearchParams({
                action: 'TEMPLATE',
                text: meeting.title || 'Termin',
                dates: `${icsLocal(meeting, 0)}/${icsLocal(meeting, durationOf(meeting))}`,
                details,
                location: meeting.location || ''
            });
            return `https://calendar.google.com/calendar/render?${params.toString()}`;
        };

        const meetingJson = (meeting) => JSON.stringify({
            id: meeting.id,
            key_user_id: meeting.key_user_id || '',
            title: meeting.title || '',
            agenda: meeting.agenda || '',
            notes: meeting.notes || '',
            meeting_date: meeting.meeting_date || '',
            start_time: meeting.start_time || '',
            duration_minutes: durationOf(meeting),
            location: meeting.location || '',
            status: meeting.status || 'planned',
            follow_up_of: meeting.follow_up_of || ''
        }).replace(/'/g, '&#39;');

        const STATUS_META = {
            planned: { label: 'Geplant', badge: 'bg-blue-100 text-blue-800' },
            done: { label: 'Erledigt', badge: 'bg-green-100 text-green-800' },
            cancelled: { label: 'Abgesagt', badge: 'bg-gray-100 text-gray-600' }
        };
        const ROLE_LABELS = { key_user: 'Key-User', evaluator: 'Evaluator', decision_maker: 'Entscheider' };
        const statusMeta = (status) => STATUS_META[status] || STATUS_META.planned;

        const upcomingMeetings = meetings.filter((meeting) => meeting.status === 'planned' && meeting.meeting_date >= today);
        const pastMeetings = meetings
            .filter((meeting) => !(meeting.status === 'planned' && meeting.meeting_date >= today))
            .slice()
            .reverse();

        const sections = [
            { key: 'upcoming', title: 'Anstehende Termine', list: upcomingMeetings, empty: 'Keine anstehenden Termine.' },
            { key: 'past', title: 'Erledigt & Vergangen', list: pastMeetings, empty: 'Noch keine erledigten Termine.' }
        ];
        %>

        <nav class="mb-6" aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm sm:text-base">
                <li><a href="/" class="text-gray-500 hover:text-gray-700">Dashboard</a></li>
                <li class="text-gray-400">/</li>
                <li><a href="/projects" class="text-gray-500 hover:text-gray-700">Projekte</a></li>
                <li class="text-gray-400">/</li>
                <li><a href="/project/<%= project.id %>" class="text-gray-500 hover:text-gray-700"><%= project.name %></a></li>
                <li class="text-gray-400">/</li>
                <li class="text-gray-900 font-medium">Termine</li>
            </ol>
        </nav>

        <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Termine: <%= project.name %></h1>
                <p class="mt-1 text-sm text-gray-500">
                    Meetings mit Key-Usern festhalten, Follow-up direkt planen und als ICS bzw. in den Google Kalender exportieren.
                </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <a href="/api/projects/<%= project.id %>/meetings.ics" class="btn-secondary text-sm">Alle exportieren (.ics)</a>
                <% if (canManage) { %>
                <button type="button" onclick="toggleMeetingForm()" class="btn-primary text-sm">+ Termin</button>
                <% } %>
            </div>
        </div>

        <%- include('partials/project-nav', { active: 'meetings' }) %>

        <% if (canManage) { %>
        <div id="meetingFormCard" class="card mb-8 hidden">
            <div class="card-header flex items-center justify-between gap-3">
                <h2 id="meetingFormTitle" class="text-lg font-semibold text-gray-900">Neuen Termin erfassen</h2>
                <button type="button" onclick="toggleMeetingForm()" class="text-gray-400 hover:text-gray-600" aria-label="Schliessen">&times;</button>
            </div>
            <div class="card-body">
                <p id="followUpHint" class="mb-4 hidden rounded-lg border border-primary-200 bg-primary-50 px-3 py-2 text-sm text-primary-800"></p>
                <form id="meetingForm" onsubmit="saveMeeting(event)" class="space-y-4">
                    <input type="hidden" name="id" value="">
                    <input type="hidden" name="follow_up_of" value="">
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <div class="md:col-span-2">
                            <label class="mb-1 block text-sm font-medium text-gray-700">Titel *</label>
                            <input name="title" required class="form-input" placeholder="z. B. Abstimmung Rollout Fahrplan">
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700">Key-User</label>
                            <select name="key_user_id" class="form-input">
                                <option value="">Kein Bezug</option>
                                <% keyUsers.forEach(k => { %>
                                <option value="<%= k.id %>"><%= k.name %> (<%= ROLE_LABELS[k.role] || k.role %>)</option>
                                <% }); %>
                            </select>
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700">Ort / Link</label>
                            <input name="location" class="form-input" placeholder="z. B. Teams oder vor Ort">
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700">Datum *</label>
                            <input type="date" name="meeting_date" required class="form-input">
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700">Uhrzeit</label>
                            <input type="time" name="start_time" class="form-input">
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700">Dauer</label>
                            <select name="duration_minutes" class="form-input">
                                <option value="15">15 Minuten</option>
                                <option value="30">30 Minuten</option>
                                <option value="45">45 Minuten</option>
                                <option value="60" selected>60 Minuten</option>
                                <option value="90">90 Minuten</option>
                                <option value="120">120 Minuten</option>
                            </select>
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700">Status</label>
                            <select name="status" class="form-input">
                                <option value="planned">Geplant</option>
                                <option value="done">Erledigt</option>
                                <option value="cancelled">Abgesagt</option>
                            </select>
                        </div>
                        <div class="md:col-span-2">
                            <label class="mb-1 block text-sm font-medium text-gray-700">Agenda</label>
                            <textarea name="agenda" rows="3" class="form-input" placeholder="Themen, die besprochen werden sollen"></textarea>
                        </div>
                        <div class="md:col-span-2">
                            <label class="mb-1 block text-sm font-medium text-gray-700">Notizen / Ergebnis</label>
                            <textarea name="notes" rows="3" class="form-input" placeholder="Ergebnisse, offene Punkte, Vereinbarungen"></textarea>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-3">
                        <button type="submit" id="meetingSubmitButton" class="btn-primary">Termin speichern</button>
                        <button type="button" id="meetingCancelButton" class="btn-secondary hidden" onclick="resetMeetingForm()">Abbrechen</button>
                    </div>
                </form>
            </div>
        </div>
        <% } %>

        <% if (meetings.length > 0) { %>
        <div class="card mb-6">
            <div class="card-body grid grid-cols-1 gap-3 p-4 sm:grid-cols-2">
                <div>
                    <label for="filterKeyUser" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-gray-500">Key-User</label>
                    <select id="filterKeyUser" class="form-select text-sm" onchange="applyMeetingFilters()">
                        <option value="">Alle Key-User</option>
                        <% keyUsers.forEach(k => { %>
                        <option value="<%= k.id %>"><%= k.name %></option>
                        <% }); %>
                        <option value="none">Ohne Zuordnung</option>
                    </select>
                </div>
                <div>
                    <label for="filterStatus" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-gray-500">Status</label>
                    <select id="filterStatus" class="form-select text-sm" onchange="applyMeetingFilters()">
                        <option value="">Alle Status</option>
                        <option value="planned">Geplant</option>
                        <option value="done">Erledigt</option>
                        <option value="cancelled">Abgesagt</option>
                    </select>
                </div>
            </div>
        </div>
        <% } %>

        <% sections.forEach(section => { %>
        <section class="mb-8" data-meeting-section="<%= section.key %>">
            <h2 class="mb-3 text-lg font-semibold text-gray-900">
                <%= section.title %>
                <span class="text-sm font-normal text-gray-400">(<%= section.list.length %>)</span>
            </h2>

            <div class="space-y-4">
                <% section.list.forEach(m => { %>
                <%
                const meta = statusMeta(m.status);
                const badge = dateBadge(m.meeting_date);
                const duration = durationOf(m);
                %>
                <article class="card meeting-card"
                    data-key-user-id="<%= m.key_user_id || '' %>"
                    data-status="<%= m.status %>">
                    <div class="card-body">
                        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                            <div class="flex min-w-0 items-start gap-3">
                                <div class="flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-lg bg-primary-50 leading-none text-primary-700">
                                    <span class="text-xs font-medium uppercase"><%= badge.weekday %></span>
                                    <span class="text-lg font-bold"><%= badge.day %></span>
                                    <span class="text-xs uppercase"><%= badge.month %></span>
                                </div>
                                <div class="min-w-0">
                                    <h3 class="text-base font-semibold text-gray-900 break-words"><%= m.title %></h3>
                                    <p class="mt-1 text-sm text-gray-600"><%= fmtDateLong(m.meeting_date) %> · <%= fmtTimeRange(m) %> · <%= duration %> Min.</p>
                                    <p class="mt-1 text-sm text-gray-500">
                                        <% if (m.key_user_name) { %>
                                        <span class="font-medium text-gray-700"><%= m.key_user_name %></span>
                                        <span class="badge text-xs bg-gray-100 text-gray-700"><%= ROLE_LABELS[m.key_user_role] || m.key_user_role %></span>
                                        <% } else { %>
                                        <span class="text-gray-400">Kein Key-User zugeordnet</span>
                                        <% } %>
                                        <% if (m.location) { %>
                                        <span class="ml-1 text-gray-400">· <%= m.location %></span>
                                        <% } %>
                                    </p>
                                </div>
                            </div>
                            <span class="badge self-start text-xs <%= meta.badge %>"><%= meta.label %></span>
                        </div>

                        <% if (m.follow_up_of_title) { %>
                        <p class="mt-3 rounded-lg bg-gray-50 px-3 py-2 text-xs text-gray-600">
                            Follow-up zu: <span class="font-medium text-gray-800"><%= m.follow_up_of_title %></span>
                        </p>
                        <% } %>

                        <% if (m.agenda) { %>
                        <div class="mt-3">
                            <h4 class="text-xs font-semibold uppercase tracking-wider text-gray-500">Agenda</h4>
                            <p class="mt-1 whitespace-pre-wrap text-sm text-gray-700"><%= m.agenda %></p>
                        </div>
                        <% } %>

                        <% if (m.notes) { %>
                        <div class="mt-3">
                            <h4 class="text-xs font-semibold uppercase tracking-wider text-gray-500">Notizen / Ergebnis</h4>
                            <p class="mt-1 whitespace-pre-wrap text-sm text-gray-700"><%= m.notes %></p>
                        </div>
                        <% } %>

                        <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-gray-100 pt-4">
                            <% if (canManage) { %>
                            <button type="button" class="btn-primary text-sm"
                                data-meeting='<%- meetingJson(m) %>'
                                onclick="planFollowUp(this.dataset.meeting)">Follow-up planen</button>
                            <% } %>
                            <a href="<%= googleCalendarUrl(m) %>" target="_blank" rel="noopener" class="btn-secondary text-sm">Google Kalender</a>
                            <a href="/api/projects/<%= project.id %>/meetings/<%= m.id %>/ics" class="btn-secondary text-sm">.ics</a>
                        </div>

                        <% if (canManage) { %>
                        <div class="mt-3 flex flex-wrap items-center gap-3">
                            <label class="flex items-center gap-2 text-xs text-gray-500">
                                Status
                                <select class="form-select py-1 text-xs" onchange="setMeetingStatus(<%= m.id %>, this.value)">
                                    <option value="planned" <%= m.status === 'planned' ? 'selected' : '' %>>Geplant</option>
                                    <option value="done" <%= m.status === 'done' ? 'selected' : '' %>>Erledigt</option>
                                    <option value="cancelled" <%= m.status === 'cancelled' ? 'selected' : '' %>>Abgesagt</option>
                                </select>
                            </label>
                            <button type="button" class="text-sm text-primary-600 hover:text-primary-800"
                                data-meeting='<%- meetingJson(m) %>'
                                onclick="editMeeting(this.dataset.meeting)">Bearbeiten</button>
                            <button type="button" class="text-sm text-red-600 hover:text-red-900"
                                onclick="deleteMeeting(<%= m.id %>)">Löschen</button>
                        </div>
                        <% } %>
                    </div>
                </article>
                <% }); %>

                <div class="card <%= section.list.length > 0 ? 'hidden' : '' %>">
                    <div class="card-body text-center text-sm text-gray-500" data-section-empty data-empty-default="<%= section.empty %>">
                        <%= section.empty %>
                    </div>
                </div>
            </div>
        </section>
        <% }); %>

        <% if (meetings.length === 0) { %>
        <div class="card">
            <div class="card-body text-center text-sm text-gray-500">
                <p class="font-medium text-gray-700">Noch keine Termine erfasst.</p>
                <% if (canManage) { %>
                <p class="mt-1">Lege den ersten Termin an, um Gespräche mit Key-Usern nachzuhalten.</p>
                <% } else { %>
                <p class="mt-1">Sobald Termine erfasst sind, erscheinen sie hier.</p>
                <% } %>
            </div>
        </div>
        <% } %>
    </main>

    <script>
        const CSRF_TOKEN = '<%= csrfToken %>';
        const PROJECT_ID = <%= project.id %>;
        const CAN_MANAGE = <%= canManage ? 'true' : 'false' %>;
        const FOLLOW_UP_INTERVAL_DAYS = 14;

        function toggleMeetingForm() {
            document.getElementById('meetingFormCard').classList.toggle('hidden');
        }

        function pad(value) { return String(value).padStart(2, '0'); }

        function addDays(isoDate, days) {
            const date = new Date((isoDate || new Date().toISOString().slice(0, 10)) + 'T00:00:00');
            if (Number.isNaN(date.getTime())) return '';
            date.setDate(date.getDate() + days);
            return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate());
        }

        function setFollowUpHint(text) {
            const hint = document.getElementById('followUpHint');
            if (!hint) return;
            if (text) {
                hint.textContent = text;
                hint.classList.remove('hidden');
            } else {
                hint.textContent = '';
                hint.classList.add('hidden');
            }
        }

        function resetMeetingForm() {
            const form = document.getElementById('meetingForm');
            form.reset();
            form.elements.id.value = '';
            form.elements.follow_up_of.value = '';
            form.elements.duration_minutes.value = '60';
            form.elements.status.value = 'planned';
            document.getElementById('meetingFormTitle').textContent = 'Neuen Termin erfassen';
            document.getElementById('meetingSubmitButton').textContent = 'Termin speichern';
            document.getElementById('meetingCancelButton').classList.add('hidden');
            setFollowUpHint('');
        }

        function openMeetingForm() {
            document.getElementById('meetingFormCard').classList.remove('hidden');
        }

        function editMeeting(rawMeeting) {
            const meeting = JSON.parse(rawMeeting);
            const form = document.getElementById('meetingForm');
            openMeetingForm();

            form.elements.id.value = meeting.id || '';
            form.elements.key_user_id.value = meeting.key_user_id ? String(meeting.key_user_id) : '';
            form.elements.title.value = meeting.title || '';
            form.elements.meeting_date.value = meeting.meeting_date || '';
            form.elements.start_time.value = meeting.start_time || '';
            form.elements.duration_minutes.value = String(meeting.duration_minutes || 60);
            form.elements.location.value = meeting.location || '';
            form.elements.status.value = meeting.status || 'planned';
            form.elements.agenda.value = meeting.agenda || '';
            form.elements.notes.value = meeting.notes || '';
            form.elements.follow_up_of.value = meeting.follow_up_of || '';

            document.getElementById('meetingFormTitle').textContent = 'Termin bearbeiten';
            document.getElementById('meetingSubmitButton').textContent = 'Änderungen speichern';
            document.getElementById('meetingCancelButton').classList.remove('hidden');
            setFollowUpHint('');

            document.getElementById('meetingFormCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // Follow-up: uebernimmt Key-User und Rahmendaten des Ausgangstermins,
        // legt den neuen Termin standardmaessig zwei Wochen spaeter an.
        function planFollowUp(rawMeeting) {
            const meeting = JSON.parse(rawMeeting);
            const form = document.getElementById('meetingForm');
            openMeetingForm();
            resetMeetingForm();

            form.elements.key_user_id.value = meeting.key_user_id ? String(meeting.key_user_id) : '';
            form.elements.follow_up_of.value = String(meeting.id);
            form.elements.title.value = 'Follow-up: ' + (meeting.title || 'Termin');
            form.elements.meeting_date.value = addDays(meeting.meeting_date, FOLLOW_UP_INTERVAL_DAYS);
            form.elements.start_time.value = meeting.start_time || '';
            form.elements.duration_minutes.value = String(meeting.duration_minutes || 60);
            form.elements.location.value = meeting.location || '';
            form.elements.status.value = 'planned';

            document.getElementById('meetingFormTitle').textContent = 'Follow-up planen';
            document.getElementById('meetingSubmitButton').textContent = 'Follow-up speichern';
            document.getElementById('meetingCancelButton').classList.remove('hidden');
            setFollowUpHint('Follow-up zu "' + (meeting.title || 'Termin') + '" (' + (meeting.meeting_date || '') + ')');

            document.getElementById('meetingFormCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        async function saveMeeting(event) {
            event.preventDefault();
            const form = event.target;
            const body = {
                id: form.elements.id.value || undefined,
                key_user_id: form.elements.key_user_id.value || undefined,
                title: form.elements.title.value,
                meeting_date: form.elements.meeting_date.value,
                start_time: form.elements.start_time.value || undefined,
                duration_minutes: form.elements.duration_minutes.value,
                location: form.elements.location.value || undefined,
                status: form.elements.status.value,
                agenda: form.elements.agenda.value || undefined,
                notes: form.elements.notes.value || undefined,
                follow_up_of: form.elements.follow_up_of.value || undefined
            };

            const resp = await fetch('/api/projects/' + PROJECT_ID + '/meetings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
                body: JSON.stringify(body)
            });
            if (resp.ok) {
                location.reload();
                return;
            }
            const err = await resp.json().catch(() => ({}));
            alert('Fehler: ' + (err.error || resp.statusText));
        }

        async function setMeetingStatus(id, status) {
            const resp = await fetch('/api/meetings/' + id + '/status', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
                body: JSON.stringify({ status })
            });
            if (resp.ok) {
                location.reload();
                return;
            }
            const err = await resp.json().catch(() => ({}));
            alert('Fehler: ' + (err.error || resp.statusText));
        }

        async function deleteMeeting(id) {
            if (!confirm('Termin wirklich löschen?')) return;
            const resp = await fetch('/api/meetings/' + id, {
                method: 'DELETE',
                headers: { 'X-CSRF-Token': CSRF_TOKEN }
            });
            if (resp.ok) {
                location.reload();
                return;
            }
            const err = await resp.json().catch(() => ({}));
            alert('Fehler: ' + (err.error || resp.statusText));
        }

        function applyMeetingFilters() {
            const keyUserEl = document.getElementById('filterKeyUser');
            const statusEl = document.getElementById('filterStatus');
            const keyUserFilter = keyUserEl ? keyUserEl.value : '';
            const statusFilter = statusEl ? statusEl.value : '';
            const anyFilter = !!(keyUserFilter || statusFilter);

            document.querySelectorAll('.meeting-card').forEach((card) => {
                const cardKeyUser = card.dataset.keyUserId || '';
                let keyUserMatch = true;
                if (keyUserFilter === 'none') keyUserMatch = cardKeyUser === '';
                else if (keyUserFilter) keyUserMatch = cardKeyUser === keyUserFilter;

                const statusMatch = !statusFilter || card.dataset.status === statusFilter;
                card.classList.toggle('hidden', !(keyUserMatch && statusMatch));
            });

            document.querySelectorAll('[data-meeting-section]').forEach((section) => {
                const visible = section.querySelectorAll('.meeting-card:not(.hidden)').length;
                const emptyNote = section.querySelector('[data-section-empty]');
                if (!emptyNote) return;
                emptyNote.textContent = anyFilter
                    ? 'Keine Termine für diese Auswahl.'
                    : (emptyNote.dataset.emptyDefault || emptyNote.textContent);
                emptyNote.closest('.card').classList.toggle('hidden', visible > 0);
            });
        }

        // Deep-Link aus der Key-User-Seite: ?key_user=<id> filtert, &new=1 oeffnet das Formular.
        (function initMeetingViewFromQuery() {
            const params = new URLSearchParams(window.location.search);
            const keyUserId = params.get('key_user');

            const filter = document.getElementById('filterKeyUser');
            if (keyUserId && filter) {
                filter.value = keyUserId;
                applyMeetingFilters();
            }

            const formCard = document.getElementById('meetingFormCard');
            if (!CAN_MANAGE || !formCard) return;

            if (keyUserId) {
                const select = document.getElementById('meetingForm').elements.key_user_id;
                if (select) select.value = keyUserId;
            }
            if (params.get('new') === '1') {
                openMeetingForm();
                const dateInput = document.getElementById('meetingForm').elements.meeting_date;
                if (dateInput && !dateInput.value) dateInput.value = new Date().toISOString().slice(0, 10);
                if (typeof formCard.scrollIntoView === 'function') {
                    formCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }
        })();
    </script>
</body>
</html>
