<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Features | Ticketsystem</title>
    <link rel="stylesheet" href="/style.css?v=2">
    <script src="/socket.io/socket.io.js"></script>
    <style>
        /* Drag & Drop der Plan-Reihenfolge. Bewusst page-lokal, damit die
           vorgebaute style.css unverändert bleibt (Palette: primary-50/600). */
        .feat-drag-handle {
            cursor: grab;
            user-select: none;
            -webkit-user-select: none;
            color: #9ca3af;
            font-size: 1.15rem;
            line-height: 1.1;
            padding: 0.15rem 0.35rem;
            border-radius: 0.375rem;
            flex: 0 0 auto;
        }
        .feat-drag-handle:hover { color: #2563eb; background: #eff6ff; }
        .feat-drag-handle:focus-visible { outline: 2px solid #2563eb; outline-offset: 1px; }
        .feat-drag-handle:active { cursor: grabbing; }
        .feat-drag-handle--inline { cursor: inherit; font-size: 0.95rem; padding: 0 0.15rem; }
        li.feat-dragging { opacity: 0.5; background: #eff6ff; }
        ul.feat-sorting > li { transition: background-color 0.12s ease; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    <!-- Navigation -->
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <div class="flex-shrink-0 flex items-center gap-2">
                        <div class="w-8 h-8 bg-primary-600 rounded-lg flex items-center justify-center">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
                            </svg>
                        </div>
                        <a href="/" class="text-xl font-bold text-gray-900 hover:text-primary-600">Ticketsystem</a>
                    </div>
                    <div class="hidden md:ml-8 md:flex md:space-x-1">
                        <a href="/" class="nav-link">Dashboard</a>
                        <a href="/features" class="nav-link active">Features</a>
                        <% if (role === 'admin' || role === 'root') { %>
                        <a href="/stats" class="nav-link">Statistiken</a>
                        <% } %>
                        <a href="/ticket/new" class="nav-link">Neues Ticket</a>
                        <a href="/projects" class="nav-link">Projekte</a>
                        <% if (role === 'admin' || role === 'root') { %>
                        <a href="/admin/systems" class="nav-link">Systeme</a>
                        <a href="/admin/staff" class="nav-link">Mitarbeiter</a>
                        <% } %>
                        <% if (role === 'root') { %>
                        <a href="/admin/users" class="nav-link">Benutzer</a>
                        <% } %>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <span class="text-sm text-gray-600"><%= user %> <span class="badge bg-gray-100 text-gray-700"><%= role %></span></span>
                    <a href="/account" class="btn-secondary text-sm">Account</a>
                    <a href="/logout" class="btn-secondary text-sm">Abmelden</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div>
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-600">Feature-Planung</p>
                <h1 class="mt-1 text-3xl font-bold text-gray-900">Features</h1>
                <p class="mt-2 max-w-3xl text-sm text-gray-500">
                    Feature-Vorschläge je System prüfen, in den Plan aufnehmen oder verwerfen.
                    Verworfene Ideen bleiben im Ordner „Verworfene Features“ erhalten und können später
                    jederzeit wieder in den Plan verschoben werden.
                </p>
            </div>
            <div class="flex gap-2">
                <a href="/ticket/new" class="btn-primary text-sm">Neues Feature melden</a>
                <a href="/" class="btn-secondary text-sm">Zum Dashboard</a>
            </div>
        </div>

        <!-- System-Auswahl -->
        <div class="card mb-6">
            <div class="card-header flex items-center justify-between flex-wrap gap-3">
                <h3 class="text-base font-semibold text-gray-900">System auswählen</h3>
                <p class="text-xs text-gray-500">
                    <span class="badge bg-amber-100 text-amber-800">offen</span>
                    <span class="badge bg-green-100 text-green-800">geplant</span>
                    <span class="badge bg-red-100 text-red-800">verworfen</span>
                </p>
            </div>
            <div class="card-body flex flex-wrap gap-2">
                <% if (!systems.length && !(counts.none && counts.none.total > 0)) { %>
                <p class="text-sm text-gray-500">Es sind noch keine Systeme angelegt.</p>
                <% } %>
                <% systems.forEach(sys => { const c = counts[String(sys.id)] || { pending: 0, planned: 0, rejected: 0, total: 0 }; %>
                <a href="/features?system=<%= sys.id %>" class="nav-link <%= String(selected) === String(sys.id) ? 'active' : '' %>">
                    <span class="font-medium"><%= sys.name %></span>
                    <span class="badge bg-amber-100 text-amber-800" title="Zu entscheiden"><%= c.pending %></span>
                    <span class="badge bg-green-100 text-green-800" title="Geplant"><%= c.planned %></span>
                    <span class="badge bg-red-100 text-red-800" title="Verworfen"><%= c.rejected %></span>
                </a>
                <% }); %>
                <% if (counts.none && counts.none.total > 0) { %>
                <a href="/features?system=none" class="nav-link <%= selected === 'none' ? 'active' : '' %>">
                    <span class="font-medium">Ohne System</span>
                    <span class="badge bg-amber-100 text-amber-800" title="Zu entscheiden"><%= counts.none.pending %></span>
                    <span class="badge bg-green-100 text-green-800" title="Geplant"><%= counts.none.planned %></span>
                    <span class="badge bg-red-100 text-red-800" title="Verworfen"><%= counts.none.rejected %></span>
                </a>
                <% } %>
            </div>
        </div>

        <% if (selectedSystem) { %>
        <div class="mb-6 flex flex-wrap items-center gap-3">
            <h2 class="text-xl font-bold text-gray-900"><%= selectedSystem.name %></h2>
            <span class="text-sm text-gray-500"><%= totalFeatures %> Feature<%= totalFeatures === 1 ? '' : 's' %></span>
        </div>
        <% } %>

        <% if (!selectedSystem) { %>
        <div class="card mb-8">
            <div class="card-body text-center py-12">
                <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
                <h3 class="text-lg font-medium text-gray-900 mb-2">Kein System ausgewählt</h3>
                <p class="text-gray-500 mb-4">Legen Sie zuerst ein System an, um Features zu organisieren.</p>
                <a href="/admin/systems" class="btn-primary">Systeme verwalten</a>
            </div>
        </div>
        <% } else { %>

        <%
        const sections = [
            {
                key: 'pending',
                title: 'Zu entscheiden',
                hint: 'Vorschläge, die noch in den Plan aufgenommen oder verworfen werden müssen.',
                empty: 'Keine offenen Feature-Vorschläge.',
                list: groups.pending
            },
            {
                key: 'planned',
                title: 'Geplante Features',
                hint: 'In den Plan aufgenommen – die Umsetzung läuft hier wie gewohnt.',
                empty: 'Noch keine geplanten Features.',
                list: groups.planned
            },
            {
                key: 'rejected',
                title: 'Verworfene Features',
                hint: 'Verworfene Ideen bleiben archiviert und können reaktiviert werden.',
                empty: 'Noch keine verworfenen Features.',
                list: groups.rejected
            }
        ];
        %>

        <% sections.forEach(section => { %>
        <div class="card mb-6">
            <div class="card-header flex items-center justify-between flex-wrap gap-3">
                <h3 class="text-base font-semibold text-gray-900">
                    <%= section.title %>
                    <span class="text-gray-400 font-normal">(<%= section.list.length %>)</span>
                </h3>
                <div class="flex items-center gap-3 flex-wrap">
                    <% if (section.key === 'planned' && canManageTickets && section.list.length > 1) { %>
                    <p class="text-xs text-gray-500">Reihenfolge (Priorität) per Drag &amp; Drop am Griff <span class="feat-drag-handle feat-drag-handle--inline" aria-hidden="true">⠿</span> ändern.</p>
                    <span class="text-xs font-medium text-green-800 hidden" data-sort-status role="status" aria-live="polite"></span>
                    <% } else { %>
                    <p class="text-xs text-gray-500"><%= section.hint %></p>
                    <% } %>
                </div>
            </div>
            <div class="card-body p-0">
                <% if (!section.list.length) { %>
                <p class="px-6 py-6 text-sm text-gray-500"><%= section.empty %></p>
                <% } else { %>
                <ul class="divide-y divide-gray-200"
                    <% if (section.key === 'planned' && canManageTickets) { %>data-feature-sortable data-system-id="<%= selected %>"<% } %>>
                    <% section.list.forEach((t, index) => { %>
                    <% const sortable = section.key === 'planned' && canManageTickets; %>
                    <li class="px-6 py-4" data-feature-id="<%= t.id %>">
                        <div class="flex flex-wrap items-start justify-between gap-4">
                            <% if (sortable) { %>
                            <span class="feat-drag-handle" draggable="true" data-drag-handle
                                title="Ziehen, um die Priorität zu ändern" aria-label="Priorität ändern"
                                role="button" tabindex="0">⠿</span>
                            <% } %>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <% if (section.key === 'planned') { %>
                                    <span class="badge bg-gray-100 text-gray-700" data-rank-badge title="Priorität im Plan: <%= index + 1 %>"><%= index + 1 %></span>
                                    <% } %>
                                    <a href="/ticket/<%= t.id %>" class="text-sm font-medium text-gray-900 hover:text-primary-600"><%= t.title %></a>
                                    <span class="badge badge-priority-<%= t.priority %>"><%= toTitle(t.priority) %></span>
                                    <span class="badge badge-status-<%= t.status %>"><%= toTitle(t.status) %></span>
                                    <span class="text-xs text-gray-400">#<%= t.id.substring(0, 8) %>&hellip;</span>
                                </div>
                                <p class="mt-1 text-xs text-gray-500">
                                    <%= t.system_name || 'Ohne System' %>
                                    &middot; erstellt <%= formatDateTime(t.created_at) %>
                                    <% if (t.username) { %> &middot; gemeldet von <%= t.username %><% } %>
                                    <% if (t.assigned_name) { %> &middot; zugewiesen an <%= t.assigned_name %><% } %>
                                    <% if (t.feature_decided_by && section.key !== 'pending') { %> &middot; entschieden von <%= t.feature_decided_by %><% } %>
                                </p>
                                <% if (t.feature_reason && section.key === 'rejected') { %>
                                <p class="mt-1 text-xs text-gray-600"><strong>Begründung:</strong> <%= t.feature_reason %></p>
                                <% } %>
                            </div>
                            <% if (canManageTickets) { %>
                            <div class="flex items-center gap-2 flex-wrap">
                                <% if (section.key !== 'planned') { %>
                                <form method="post" action="/ticket/<%= t.id %>/feature-decision">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="decision" value="planned">
                                    <input type="hidden" name="redirect" value="/features?system=<%= selected %>">
                                    <button type="submit" class="btn-primary text-sm">In Plan aufnehmen</button>
                                </form>
                                <% } %>
                                <% if (section.key !== 'rejected') { %>
                                <form method="post" action="/ticket/<%= t.id %>/feature-decision" class="flex items-center gap-2"
                                    onsubmit="return confirm('Feature #<%= t.id.substring(0, 8) %> wirklich verwerfen?')">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="decision" value="rejected">
                                    <input type="hidden" name="redirect" value="/features?system=<%= selected %>">
                                    <input type="text" name="reason" class="form-input text-sm" style="max-width:220px" placeholder="Grund (optional)">
                                    <button type="submit" class="btn-danger text-sm">Verwerfen</button>
                                </form>
                                <% } %>
                                <% if (section.key === 'planned') { %>
                                <form method="post" action="/ticket/<%= t.id %>/feature-decision">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="decision" value="pending">
                                    <input type="hidden" name="redirect" value="/features?system=<%= selected %>">
                                    <button type="submit" class="btn-secondary text-sm">Zurück in die Inbox</button>
                                </form>
                                <% } %>
                                <a href="/ticket/<%= t.id %>" class="btn-secondary text-sm">Öffnen</a>
                            </div>
                            <% } %>
                        </div>
                    </li>
                    <% }); %>
                </ul>
                <% } %>
            </div>
        </div>
        <% }); %>

        <% } %>
    </main>

    <script>
        // Zeitpunkt der letzten eigenen Umsortierung (unterdrueckt Reload).
        let lastFeatureReorderAt = 0;

        // --- Drag & Drop: Prioritaet/Reihenfolge der geplanten Features ---
        (function initFeatureSort() {
            const list = document.querySelector('[data-feature-sortable]');
            if (!list) return;

            const statusEl = document.querySelector('[data-sort-status]');
            const systemId = list.dataset.systemId || '';
            let dragged = null;

            const items = () => Array.from(list.querySelectorAll('[data-feature-id]'));

            const renumber = () => {
                items().forEach((li, index) => {
                    const badge = li.querySelector('[data-rank-badge]');
                    if (!badge) return;
                    badge.textContent = String(index + 1);
                    badge.title = 'Priorität im Plan: ' + (index + 1);
                });
            };

            const setStatus = (text, isError) => {
                if (!statusEl) return;
                statusEl.textContent = text || '';
                statusEl.className = 'text-xs font-medium ' + (isError ? 'text-red-600' : 'text-green-800') + (text ? '' : ' hidden');
            };

            const save = async () => {
                const order = items().map(li => li.dataset.featureId);
                list.style.pointerEvents = 'none';
                setStatus('Speichere Reihenfolge…', false);
                try {
                    const resp = await fetch('/api/features/reorder', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ system_id: systemId, order })
                    });
                    if (!resp.ok) {
                        let message = 'HTTP ' + resp.status;
                        try {
                            const data = await resp.json();
                            if (data && data.error) message = data.error;
                        } catch (_) {}
                        throw new Error(message);
                    }
                    lastFeatureReorderAt = Date.now();
                    setStatus('Reihenfolge gespeichert', false);
                    setTimeout(() => setStatus('', false), 2500);
                } catch (err) {
                    // Serverstand wiederherstellen, damit UI und DB nicht auseinanderlaufen.
                    setStatus('Speichern fehlgeschlagen: ' + err.message, true);
                    setTimeout(() => location.reload(), 1500);
                } finally {
                    list.style.pointerEvents = '';
                }
            };

            list.addEventListener('dragstart', (event) => {
                const handle = event.target.closest('[data-drag-handle]');
                if (!handle) {
                    event.preventDefault();
                    return;
                }
                dragged = handle.closest('[data-feature-id]');
                if (!dragged) return;
                dragged.classList.add('feat-dragging');
                list.classList.add('feat-sorting');
                event.dataTransfer.effectAllowed = 'move';
                try { event.dataTransfer.setData('text/plain', dragged.dataset.featureId); } catch (_) {}
            });

            list.addEventListener('dragover', (event) => {
                if (!dragged) return;
                event.preventDefault();
                event.dataTransfer.dropEffect = 'move';
                const target = event.target.closest('[data-feature-id]');
                if (!target || target === dragged) return;
                const rect = target.getBoundingClientRect();
                const insertAfter = event.clientY > rect.top + rect.height / 2;
                list.insertBefore(dragged, insertAfter ? target.nextSibling : target);
                renumber();
            });

            list.addEventListener('drop', (event) => event.preventDefault());

            list.addEventListener('dragend', () => {
                if (!dragged) return;
                dragged.classList.remove('feat-dragging');
                list.classList.remove('feat-sorting');
                dragged = null;
                renumber();
                save();
            });

            // Tastaturbedienung: Pfeiltasten verschieben das Feature am Griff.
            list.addEventListener('keydown', (event) => {
                const handle = event.target.closest('[data-drag-handle]');
                if (!handle) return;
                const item = handle.closest('[data-feature-id]');
                if (!item) return;
                if (event.key === 'ArrowUp' && item.previousElementSibling) {
                    event.preventDefault();
                    list.insertBefore(item, item.previousElementSibling);
                } else if (event.key === 'ArrowDown' && item.nextElementSibling) {
                    event.preventDefault();
                    list.insertBefore(item.nextElementSibling, item);
                } else {
                    return;
                }
                renumber();
                handle.focus();
                save();
            });
        })();

        // Live-Aktualisierung bei Entscheidungen. Eigene Umsortierungen loesen
        // keinen Reload aus, damit mehrere Drags hintereinander möglich sind.
        if (typeof io === 'function') {
            const socket = io();
            socket.on('feature-updated', (data) => {
                const isOwnReorder = data && data.reordered && (Date.now() - lastFeatureReorderAt) < 3000;
                if (isOwnReorder) return;
                location.reload();
            });
            socket.on('ticket-updated', (data) => {
                if (data && data.updates && data.updates.feature_decision) location.reload();
            });
        }
    </script>
</body>
</html>
